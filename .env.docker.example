# Pure Mania Docker Compose configuration
#
# Copy this file to .env.docker, edit the host paths, then run:
#   docker compose --env-file .env.docker up -d --build

# Run the container with the host user's numeric IDs.
PUREMANIA_UID=1000
PUREMANIA_GID=1000

# Host directory mounted at /home/puremania in the container.
PUREMANIA_HOST_HOME=/home/tux

# Set a host path for bind-mounted storage, or keep the named volume default.
PUREMANIA_STORAGE_DIR=puremania-data

# Set to enable to start the bundled aria2c daemon.
PUREMANIA_ARIA2C=enable

# Application limits.
PUREMANIA_MAX_FILE_SIZE_MB=102400
PUREMANIA_ZIP_TIMEOUT=300
PUREMANIA_MAX_ZIP_SIZE=1024

# Optional comma-separated paths visible to the application.
PUREMANIA_MOUNT_DIRS=
PUREMANIA_SPECIFIC_DIRS=
