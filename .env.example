# Pure Mania Configuration

# Main storage directory
# example: STORAGE_DIR=/home/tux
STORAGE_DIR=/home/$USER

# Additional mount directories (comma-separated)
# example: MOUNT_DIRS=/mnt/disk1
MOUNT_DIRS=

# Maximum file size (MB)
MAX_FILE_SIZE_MB=10000

# Server port
PORT=8844

# ZIP processing timeout (seconds)
ZIP_TIMEOUT=300

# Maximum ZIP file size (MB)
MAX_ZIP_SIZE=1024

# Specific directories to show in the sidebar (comma-separated full paths)
# If empty, default directories (Documents, Images, etc. in user's home) will be used.
# example: SPECIFIC_DIRS=/mnt/data/photos,/mnt/data/videos
SPECIFIC_DIRS=


# HLS on-demand transcoding. Defaults to enabled if ffmpeg is available.
HLS_ENABLED=true
# Persistent cache location; must be writable and NOT publicly served.
# HLS_CACHE_DIR=/home/tux/.cache/puremania/hls
# Cache quota in MiB; 2048 by default. Oldest completed outputs are evicted.
HLS_CACHE_MAX_MB=2048
# Expire cached outputs that have not been accessed for this many hours.
HLS_CACHE_MAX_AGE_HOURS=72
# Max concurrent ffmpeg jobs (1-4).
HLS_MAX_JOBS=1
